# ==========================================
# Dependencies / 依赖目录
# ==========================================
node_modules/


# ==========================================
# Logs / 日志文件
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ==========================================
# Editor / 编辑器配置
# ==========================================
.vscode/
.idea/
*.swp
*.swo


# ==========================================
# OS / 系统文件
# ==========================================
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini


# ==========================================
# Environment / 环境变量
# 注意：不要把密钥、Token、数据库密码上传到 GitHub
# ==========================================
.env
.env.*
!.env.example


# ==========================================
# Sass / SCSS 缓存与 Source Map
# ==========================================
.sass-cache/
*.css.map

# 注意：css/style.css 要提交到仓库
# 因为 GitHub Pages 需要编译后的产物
# 每次部署前记得先执行 npm run build 或 npm run build:all


# ==========================================
# Build / 构建缓存与临时目录
# ==========================================
dist/
build/
.cache/
.temp/
tmp/
coverage/


# ==========================================
# Assets / 素材临时文件
# ==========================================

# 图片优化前的原图备份，不上传
assets/_originals/

# 临时导出、压缩、切图文件
assets/_temp/
assets/temp/
assets/export/
assets/backup/


# ==========================================
# Audio / 音频与歌词(版权保护)
# 本地音乐收藏一律不进仓库。用大小写字符组匹配,Linux/macOS(core.ignorecase=false)
# 下 .MP3 / .Flac 等变体同样被忽略。获得公开托管授权、并通过 npm run music:check
# 的人工批准清单后,才可用 git add -f 单独添加。
# ==========================================
*.[mM][pP]3
*.[mM]4[aA]
*.[mM]4[bB]
*.[aA][aA][cC]
*.[fF][lL][aA][cC]
*.[wW][aA][vV]
*.[oO][gG][gG]
*.[oO][gG][aA]
*.[oO][pP][uU][sS]
*.[wW][eE][bB][aA]
*.[wW][mM][aA]
*.[aA][iI][fF]
*.[aA][iI][fF][fF]
*.[aA][iI][fF][cC]
*.[aA][pP][eE]
*.[aA][lL][aA][cC]
*.[aA][mM][rR]
*.[cC][aA][fF]
*.[mM][kK][aA]
*.[mM][iI][dD]
*.[mM][iI][dD][iI]
*.[lL][rR][cC]
*.[kK][rR][cC]
*.[qQ][rR][cC]


# ==========================================
# PurgeCSS / CSS 清理诊断产物
# ==========================================
css/purged/


# ==========================================
# Backup / 备份文件
# ==========================================

# 旧 HTML 备份文件，不发布
*.bak

# 其他常见备份文件
*.backup
*.old
*.orig


# ==========================================
# Archive / 压缩包
# 通常不建议把本地压缩包上传到仓库
# ==========================================
*.zip
*.rar
*.7z
*.tar
*.tar.gz


# ==========================================
# Python / Python 缓存
# generate_gallery_data.py，所以加入
# ==========================================
__pycache__/
*.py[cod]
.pytest_cache/


# ==========================================
# Local server / 本地服务缓存
# ==========================================
.local/
# Local test artifacts / 本地测试产物
artifacts/
