{
  "name": "my-website",
  "version": "1.0.0",
  "description": "Yang181969 的个人网站",
  "private": true,
  "scripts": {
    "dev": "sass css/scss/main.scss:css/style.css --watch",
    "build": "sass css/scss/main.scss:css/style.css --style=compressed --no-source-map",

    "build:critical": "sass css/scss/critical.scss:css/critical.css --style=compressed --no-source-map",
    "inline:critical": "node scripts/5-inline-critical.mjs",

    "aggregate:updates": "node scripts/6-aggregate-updates.mjs",
    "aggregate:stats":   "node scripts/7-aggregate-stats.mjs",
    "gallery:data": "python generate_gallery_data.py",

    "optimize:animes": "node scripts/1-rename-anime-images.js",
    "optimize:gallery": "node scripts/2-optimize-gallery.js",
    "update:refs": "node scripts/3-update-html-references.js",
    "optimize:portraits": "node scripts/4-optimize-portraits.mjs",

    "purgecss": "node scripts/8-purgecss.mjs",
    "music:add": "node scripts/9-add-music.mjs",
    "music:sync": "node scripts/9-add-music.mjs --sync",
    "music:covers": "node scripts/10-generate-music-covers.mjs",
    "portrait:rotation": "node scripts/11-generate-portrait-rotation.mjs",
    "tags:sync": "node scripts/13-sync-site-tags.mjs",

    "build:all": "npm run gallery:data && npm run aggregate:updates && npm run tags:sync && npm run aggregate:stats && npm run build && npm run build:critical && npm run inline:critical"
  },

  "devDependencies": {
    "glob": "^13.0.6",
    "purgecss": "^8.0.0",
    "sass": "^1.77.0",
    "sharp": "^0.34.5"
  }
}
